<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <contentai>
            <general>
                <enabled>1</enabled>
                <debug_log>0</debug_log>
                <default_content_locale>en_US</default_content_locale>
                <product_attributes>name,short_description,description,meta_title,meta_keyword,meta_description,image_label,small_image_label,thumbnail_label</product_attributes>
                <category_attributes>name,description,meta_title,meta_keywords,meta_description</category_attributes>
            </general>
            <api>
                <provider>openai</provider>
                <openai_model>gpt-5.6-luna</openai_model>
                <openai_max_tokens>1200</openai_max_tokens>
                <anthropic_model>claude-sonnet-5</anthropic_model>
                <anthropic_max_tokens>1200</anthropic_max_tokens>
            </api>
        </contentai>
    </default>
</config>
