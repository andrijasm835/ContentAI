<script>
require(['jquery'], function ($) {
    'use strict';
    var $form = $('[data-contentai-seo-form]');

    function updateForm() {
        var hasStore = $form.find('[data-seo-store]').val() !== '';
        var scope = $form.find('[data-seo-scope]:checked').val() || '';
        $form.find('[data-seo-step="scope"]').prop('hidden', !hasStore);
        $form.find('[data-seo-step="filters"], [data-seo-step="batch"], .contentai-seo-actions').prop('hidden', !scope);
        $form.find('[data-contentai-scope-panel]').each(function () {
            var panel = $(this).data('contentai-scope-panel');
            $(this).prop('hidden', !(scope === 'all' || scope === panel));
        });
    }

    $form.on('change', '[data-seo-store], [data-seo-scope]', updateForm);
    $form.on('submit', function () {
        $form.addClass('is-submitting');
        $form.find('button[type="submit"]').prop('disabled', true);
    });
    updateForm();
});
</script>
