<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <tab id="nistruct" translate="label" sortOrder="110" class="nistruct-tab">
            <label>Nistruct Extensions</label>
        </tab>
        <section id="contentai" translate="label" sortOrder="20" type="text" showInDefault="1" showInWebsite="1" showInStore="1">
            <class>separator-top</class>
            <label>ContentAI</label>
            <tab>nistruct</tab>
            <resource>Nistruct_ContentAI::configuration</resource>
            <group id="general" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>General</label>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1">
                    <label>Enable</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="debug_log" translate="label" type="select" sortOrder="20" showInDefault="1">
                    <label>Debug Logging</label>
                    <comment><![CDATA[Log full request/response details. Enable only in development.]]></comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="default_content_locale" translate="label comment" type="select" sortOrder="30" showInDefault="1">
                    <label>Default Content Locale</label>
                    <comment>Language used when generating content for All Store Views (store ID 0).</comment>
                    <source_model>Magento\Config\Model\Config\Source\Locale</source_model>
                </field>
                <field id="language_instruction" translate="label comment" type="textarea" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Additional Language Instruction</label>
                    <comment>Optional writing instruction for this scope, for example a preferred script, terminology or tone.</comment>
                </field>
                <field id="product_attributes" translate="label comment" type="multiselect" sortOrder="50" showInDefault="1">
                    <label>Allowed Product Attributes</label><comment>Text attributes ContentAI may generate and update.</comment>
                    <source_model>Nistruct\ContentAI\Model\Config\Source\ProductAttributes</source_model>
                </field>
                <field id="category_attributes" translate="label comment" type="multiselect" sortOrder="60" showInDefault="1">
                    <label>Allowed Category Attributes</label><comment>Text attributes ContentAI may generate and update.</comment>
                    <source_model>Nistruct\ContentAI\Model\Config\Source\CategoryAttributes</source_model>
                </field>
            </group>
            <group id="api" translate="label" type="text" sortOrder="20" showInDefault="1">
                <label>API Configuration</label>
                <field id="provider" translate="label" type="select" sortOrder="10" showInDefault="1">
                    <label>Provider</label>
                    <source_model>Nistruct\ContentAI\Model\Config\Source\Provider</source_model>
                </field>
                <field id="openai_api_key" translate="label" type="obscure" sortOrder="20" showInDefault="1">
                    <label>OpenAI API Key</label>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                    <depends>
                        <field id="provider">openai</field>
                    </depends>
                </field>
                <field id="openai_model" translate="label comment" type="text" sortOrder="30" showInDefault="1">
                    <label>OpenAI Model ID</label>
                    <comment>Enter any model ID supported by the OpenAI Responses API.</comment>
                    <validate>required-entry</validate>
                    <depends>
                        <field id="provider">openai</field>
                    </depends>
                </field>
                <field id="openai_max_tokens" translate="label" type="text" sortOrder="40" showInDefault="1">
                    <label>OpenAI Max Response Length</label>
                    <validate>required-entry validate-digits</validate>
                    <depends>
                        <field id="provider">openai</field>
                    </depends>
                </field>
                <field id="anthropic_api_key" translate="label" type="obscure" sortOrder="50" showInDefault="1">
                    <label>Anthropic API Key</label>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                    <depends>
                        <field id="provider">anthropic</field>
                    </depends>
                </field>
                <field id="anthropic_model" translate="label comment" type="text" sortOrder="60" showInDefault="1">
                    <label>Anthropic Model ID</label>
                    <comment>Enter any active Claude API model ID.</comment>
                    <validate>required-entry</validate>
                    <depends>
                        <field id="provider">anthropic</field>
                    </depends>
                </field>
                <field id="anthropic_max_tokens" translate="label" type="text" sortOrder="70" showInDefault="1">
                    <label>Anthropic Max Response Length</label>
                    <validate>required-entry validate-digits</validate>
                    <depends>
                        <field id="provider">anthropic</field>
                    </depends>
                </field>
            </group>
        </section>
    </system>
</config>
