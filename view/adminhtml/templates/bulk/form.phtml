<script>
require(['jquery'], function ($) {
    'use strict';
    var $form = $('[data-contentai-bulk-form]');
    var $storeStep = $form.find('[data-step="stores"]');
    var $sourceStep = $form.find('[data-step="source"]');
    var $generationStep = $form.find('[data-step="generation"]');
    var $condition = $form.find('[data-content-condition]');
    var $actions = $form.find('.contentai-bulk-actions');
    var $submit = $form.find('button[type="submit"]');

    function checkedValues(selector) {
        return $form.find(selector + ':checked').map(function () { return String(this.value); }).get();
    }

    function hasValidSource() {
        var source = $form.find('[data-source-choice]:checked').val();
        if (source === 'category') {
            return Boolean($form.find('#contentai_category_id').val());
        }
        return source === 'skus' && Boolean($.trim($form.find('#contentai_skus').val()));
    }

    function updateCategoryRows(activeStoreId) {
        var query = $.trim($form.find('[data-category-search]').val()).toLocaleLowerCase();
        var visibleCount = 0;
        var selectedCategoryExists = false;
        var selectedCategoryId = $form.find('#contentai_category_id').val();
        $form.find('[data-category-item]').each(function () {
            var $item = $(this);
            var belongsToStore = String($item.data('category-store-id')) === String(activeStoreId || '');
            var matchesSearch = !query || String($item.data('category-search-text')).indexOf(query) !== -1;
            var visible = belongsToStore && matchesSearch;
            $item.prop('hidden', !visible);
            if (visible) { visibleCount++; }
            if (belongsToStore && String($item.find('input').val()) === String(selectedCategoryId)) {
                selectedCategoryExists = true;
            }
        });
        if (selectedCategoryId && !selectedCategoryExists) {
            $form.find('[data-category-choice]').prop('checked', false);
            $form.find('#contentai_category_id').val('');
        }
        $form.find('[data-category-empty]').prop('hidden', visibleCount > 0);
    }

    function updateForm() {
        var websiteIds = checkedValues('[data-website-choice]');
        var websiteLookup = {};
        $.each(websiteIds, function (_, id) { websiteLookup[id] = true; });
        $form.find('[data-store-option]').each(function () {
            var $option = $(this);
            var visible = String($option.data('global-store')) === '1'
                ? websiteIds.length > 0
                : Boolean(websiteLookup[String($option.data('website-id'))]);
            $option.prop('hidden', !visible);
            if (!visible) { $option.find('input').prop('checked', false); }
        });
        var selectedStoreIds = checkedValues('[data-store-choice]');
        var categoryStoreId = $.grep(selectedStoreIds, function (id) { return id !== '0'; })[0];
        if (!categoryStoreId && websiteIds.length) {
            categoryStoreId = $form.find('[data-website-choice][value="' + websiteIds[0] + '"]').data('default-store-id');
        }
        updateCategoryRows(categoryStoreId);
        $storeStep.prop('hidden', websiteIds.length === 0);
        var hasStores = selectedStoreIds.length > 0;
        $sourceStep.prop('hidden', !hasStores);
        var source = $form.find('[data-source-choice]:checked').val();
        $form.find('[data-source-panel]').each(function () {
            $(this).prop('hidden', $(this).data('source-panel') !== source);
        });
        var sourceReady = hasStores && hasValidSource();
        $generationStep.prop('hidden', !sourceReady);
        var hasFields = checkedValues('[data-field-choice]').length > 0;
        $condition.prop('hidden', !hasFields);
        $actions.prop('hidden', !(sourceReady && hasFields));
        $submit.prop('disabled', !(sourceReady && hasFields));
    }

    $form.on('change', '[data-category-choice]', function () {
        $form.find('#contentai_category_id').val(this.value);
    });
    $form.on('change input', 'input, select, textarea', updateForm);
    $form.on('submit', function () {
        $form.addClass('is-submitting');
        $submit.prop('disabled', true);
    });
    updateForm();
});
</script>
